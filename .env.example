# universal-email-mcp environment template.
# Copy to your shell profile or MCP client env block. The server does NOT load
# .env automatically. Never commit a filled-in copy.

# Account configuration file (default: ~/.config/universal-email-mcp/accounts.json)
EMAIL_MCP_CONFIG=/absolute/path/to/accounts.json

# Local drafts and approval ledger (default: ~/.universal-email-mcp)
EMAIL_MCP_DATA_DIR=/absolute/path/to/universal-email-mcp-data

# Global send switch. Keep false until you have read SECURITY.md.
EMAIL_ENABLE_SEND=false

# Optional recipient allowlist: exact addresses and/or @domain entries.
# EMAIL_RECIPIENT_ALLOWLIST=you@example.com,@approved-partner.example

# Per-account send attempts per minute (default 10).
# EMAIL_SEND_RATE_LIMIT_PER_MINUTE=10

# Maximum recipients across To/Cc/Bcc (default 20).
# EMAIL_SEND_MAX_RECIPIENTS=20

# Approval token lifetime in seconds (default 900, maximum 3600).
# EMAIL_APPROVAL_TTL_SECONDS=900

# Development only: allow private/loopback mail hosts.
# EMAIL_ALLOW_PRIVATE_HOSTS=false

# Development only: allow cleartext IMAP/SMTP on loopback hosts.
# EMAIL_ALLOW_INSECURE_TRANSPORT=false

# debug | info | warn | error | silent (default info, written to stderr)
# EMAIL_LOG_LEVEL=info

# Mailbox credentials referenced by passwordEnv in accounts.json.
# CORP_MAIL_PASSWORD=
# QQ_MAIL_AUTH_CODE=
# NETEASE_163_AUTH_CODE=
