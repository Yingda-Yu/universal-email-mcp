{
  "name": "universal-email-mcp",
  "version": "0.1.0",
  "description": "Provider-agnostic, secure Model Context Protocol server for reading, searching, drafting, and sending email over IMAP/SMTP.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "universal-email-mcp": "dist/index.js",
    "universal-email-mcp-approve": "dist/cli/approve.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "approve": "tsx src/cli/approve.ts",
    "approve:built": "node dist/cli/approve.js",
    "inspect": "npx --yes @modelcontextprotocol/inspector --cli env EMAIL_MCP_CONFIG=${EMAIL_MCP_CONFIG:-examples/mock-accounts.json} EMAIL_MCP_DATA_DIR=${EMAIL_MCP_DATA_DIR:-.email-mcp/inspect} node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "imapflow": "^2.11.0",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.2",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "email",
    "imap",
    "smtp",
    "ai-agents"
  ]
}
